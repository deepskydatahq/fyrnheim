+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import yaml
+from click.testing import CliRunner
+
+from fyrnheim.cli import main
+from fyrnheim.dbt_classification import (
+    DBT_CLASSIFICATION_SCHEMA_VERSION,
+    classification_summary,
+    classify_inventory,
+)
+from fyrnheim.default_jobs_taxonomy import (
+    DEFAULT_JOB_IDS,
+    JOBS_TAXONOMY_SCHEMA_VERSION,
+    default_classification_rules,
+    describe_default_job,
+    load_default_taxonomy,
+)
+
+
+def _inventory() -> dict:
+    return {
+        "schema_version": "fyrnheim.dbt_inventory.v1",
+        "generation_source": "manifest",
+        "project": {"name": "jaffle_shop", "path": "/tmp/jaffle"},
+        "resources": {
+            "models": [
+                {
+                    "unique_id": "model.jaffle_shop.stg_customers",
+                    "name": "stg_customers",
+                    "path": "models/staging/stg_customers.sql",
+                    "materialized": "view",
+                    "tags": ["staging"],
+                    "meta": {"domain": "core"},
+                    "depends_on": ["source.jaffle_shop.raw.customers"],
+                    "downstream": ["model.jaffle_shop.int_orders"],
+                    "attached_tests": ["test.jaffle_shop.unique_customers_id"],
+                    "columns": {"id": {"name": "id"}},
+                },
+                {
+                    "unique_id": "model.jaffle_shop.int_orders",
+                    "name": "int_orders",
+                    "path": "models/intermediate/int_orders.sql",
+                    "materialized": "ephemeral",
+                    "tags": ["intermediate"],
+                    "meta": {"job": "business_rule_application"},
+                    "depends_on": ["model.jaffle_shop.stg_customers"],
+                    "downstream": ["model.jaffle_shop.fct_orders"],
+                    "attached_tests": [],
+                    "columns": {},
+                },
+                {
+                    "unique_id": "model.jaffle_shop.fct_orders",
+                    "name": "fct_orders",
+                    "path": "models/marts/fct_orders.sql",
+                    "materialized": "table",
+                    "tags": ["mart", "finance"],
+                    "meta": {"domain": "finance"},
+                    "depends_on": ["model.jaffle_shop.int_orders"],
+                    "downstream": ["exposure.jaffle_shop.orders_dashboard"],
+                    "attached_tests": [
+                        "test.jaffle_shop.unique_orders_id",
+                        "test.jaffle_shop.not_null_orders_id",
+                    ],
+                    "columns": {"id": {"name": "id"}},
+                },
+                {
+                    "unique_id": "model.jaffle_shop.silver_events_normalized",
+                    "name": "silver_events_normalized",
+                    "path": "models/silver/silver_events_normalized.sql",
+                    "materialized": "view",
+                    "tags": ["silver"],
+                    "meta": {},
+                    "depends_on": ["model.jaffle_shop.stg_customers"],
+                    "downstream": [],
+                    "attached_tests": [],
+                    "columns": {},
+                },
+            ]
+        },
+        "warnings": [],
+    }
+
+
+def test_default_taxonomy_describes_every_default_job() -> None:
+    taxonomy = load_default_taxonomy()
+
+    assert taxonomy["schema_version"] == JOBS_TAXONOMY_SCHEMA_VERSION
+    job_ids = [job["id"] for job in taxonomy["jobs"]]
+    assert tuple(job_ids) == DEFAULT_JOB_IDS
+
+    for job in taxonomy["jobs"]:
+        for key in (
+            "id",
+            "title",
+            "description",
+            "signals",
+            "examples",
+            "anti_examples",
+            "suggested_principles",
+            "related_layers",
+        ):
+            assert key in job, f"job {job.get('id')} missing {key}"
+        assert job["related_layers"], f"job {job['id']} should relate to at least one layer"
+
+    layer_ids = [layer["id"] for layer in taxonomy["layers"]]
+    # Cover common dbt structures: staging/intermediate/marts and bronze/silver/gold.
+    for expected in ("staging", "intermediate", "marts", "bronze", "silver", "gold"):
+        assert expected in layer_ids
+
+
+def test_describe_default_job_returns_entry() -> None:
+    job = describe_default_job("source_mapping")
+    assert job is not None
+    assert job["title"] == "Source mapping"
+    assert describe_default_job("does_not_exist") is None
+
+
+def test_default_classification_rules_can_classify_without_custom_file() -> None:
+    rules = default_classification_rules()
+
+    assert rules["rules_source"] == "fyrnheim:default-jobs-taxonomy"
+    assert rules["allow_multiple_labels"] is True
+    assert rules["flag_layer_job_mismatch"] is True
+    assert len(rules["rules"]) == len(DEFAULT_JOB_IDS)
+    assert rules["layer_mapping"]
+
+    result = classify_inventory(_inventory(), rules)
+
+    assert result["schema_version"] == DBT_CLASSIFICATION_SCHEMA_VERSION
+    assert result["rules_source"] == "fyrnheim:default-jobs-taxonomy"
+    assert result["allow_multiple_labels"] is True
+    assert result["flag_layer_job_mismatch"] is True
+    assert result["summary"]["total"] == 4
+    assert result["summary"]["unclassified"] == 0
+    # Every model carries evidence for its default job labels.
+    for model in result["models"]:
+        assert model["evidence"], f"{model['name']} should have evidence"
+        for match in model["evidence"]:
+            assert match["rule_id"].startswith("default-")
+            assert match["evidence"]
+
+    models = {model["name"]: model for model in result["models"]}
+    assert "source_mapping" in models["stg_customers"]["matched_labels"]
+    assert "business_rule_application" in models["int_orders"]["matched_labels"]
+    assert "analytical_output_shaping" in models["fct_orders"]["matched_labels"]
+    assert "format_alignment" in models["silver_events_normalized"]["matched_labels"]
+
+
+def test_default_classification_flags_layer_job_mismatch() -> None:
+    # A mart model that is *also* tagged as performing source mapping is a layer/job
+    # mismatch: marts do not usually perform source mapping.
+    inventory = _inventory()
+    fct = inventory["resources"]["models"][2]
+    fct["meta"] = {**fct.get("meta", {}), "job": "source_mapping"}
+
+    rules = default_classification_rules()
+    result = classify_inventory(inventory, rules)
+    fct_result = {model["name"]: model for model in result["models"]}["fct_orders"]
+
+    assert "source_mapping" in fct_result["matched_labels"]
+    assert fct_result["layer"]["detected"] == "marts"
+    assert fct_result["layer"]["mismatch"] is True
+    assert "source_mapping" in fct_result["layer"]["unexpected_jobs"]
+    assert fct_result["layer"]["mismatch_evidence"]
+    assert result["summary"]["layer_job_mismatches"] >= 1
+
+    # A clean staging model performing source mapping is not a mismatch.
+    stg = {model["name"]: model for model in result["models"]}["stg_customers"]
+    assert stg["layer"]["detected"] == "staging"
+    assert stg["layer"]["mismatch"] is False
+
+
+def test_default_classification_layer_mapping_included_in_output() -> None:
+    result = classify_inventory(_inventory(), default_classification_rules())
+
+    assert "layer_mapping" in result
+    ids = [entry["id"] for entry in result["layer_mapping"]]
+    assert "staging" in ids
+    for entry in result["layer_mapping"]:
+        assert entry["implied_jobs"]
+
+
+def test_default_classification_summary_mentions_mismatches() -> None:
+    inventory = _inventory()
+    fct = inventory["resources"]["models"][2]
+    fct["meta"] = {**fct.get("meta", {}), "job": "source_mapping"}
+
+    summary = classification_summary(
+        classify_inventory(inventory, default_classification_rules())
+    )
+
+    assert "layer/job mismatches:" in summary
+
+
+def test_mismatch_detection_can_be_disabled() -> None:
+    rules = default_classification_rules(flag_layer_job_mismatch=False)
+    inventory = _inventory()
+    fct = inventory["resources"]["models"][2]
+    fct["meta"] = {**fct.get("meta", {}), "job": "source_mapping"}
+
+    result = classify_inventory(inventory, rules)
+    fct = {model["name"]: model for model in result["models"]}["fct_orders"]
+
+    assert result["flag_layer_job_mismatch"] is False
+    assert fct["layer"]["mismatch"] is False
+    assert "unexpected_jobs" not in fct["layer"]
+    assert result["summary"]["layer_job_mismatches"] == 0
+
