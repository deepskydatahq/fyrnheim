@@ -0,0 +1,483 @@
+"""Default jobs taxonomy for dbt model classification.
+
+The default taxonomy classifies dbt models by the *job* each model performs rather
+than only by the folder or layer where it lives. It is opinionated but overridable:
+projects can supply their own rules file to ``fyr dbt classify`` and team configuration
+can extend or replace any job definition.
+
+The taxonomy is inspired by the "layers and jobs" framing: layers (staging,
+intermediate, marts, or medallion bronze/silver/gold) are useful organizing
+structures, but they are not enough to describe model purpose. A staging model may
+perform source mapping, format alignment, and data contract enforcement all at once.
+Fyrnheim's default jobs make that explicit and inspectable.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import yaml
+
+JOBS_TAXONOMY_SCHEMA_VERSION = "fyrnheim.jobs_taxonomy.v1"
+DEFAULT_CLASSIFICATION_RULES_SOURCE = "fyrnheim:default-jobs-taxonomy"
+
+# The canonical default jobs, in the order suggested by the layers-and-jobs framing.
+DEFAULT_JOB_IDS: tuple[str, ...] = (
+    "source_mapping",
+    "format_alignment",
+    "data_contract_enforcement",
+    "entity_definition",
+    "business_rule_application",
+    "analytical_output_shaping",
+    "quality_validation",
+)
+
+DEFAULT_TAXONOMY_YAML = """\
+schema_version: fyrnheim.jobs_taxonomy.v1
+name: fyrnheim-default-jobs
+title: Fyrnheim Default Jobs Taxonomy
+description: |
+  An opinionated starting point for classifying dbt models by the job each model
+  performs. Layers describe where a model lives; jobs describe what the model does.
+  A single model can perform several jobs at once. This taxonomy is intentionally
+  configurable and humble: it is a starting point for conversation, not a universal
+  truth.
+
+jobs:
+  - id: source_mapping
+    title: Source mapping
+    description: |
+      Bring raw source data into the model graph with stable names, grain, and
+      lightweight selection. The model maps external tables or files into the first
+      trusted relation of the project.
+    signals:
+      - Lives in a staging or bronze layer.
+      - Name begins with stg_ or sits under models/staging/ or models/bronze/.
+      - Depends directly on a source rather than another model.
+      - Performs renaming, column selection, and light casting without business logic.
+    examples:
+      - stg_customers selecting and renaming columns from raw.customers.
+      - bronze_orders exposing the raw orders table with stable column names.
+    anti_examples:
+      - A staging model that joins two sources and applies business rules (that is
+        business_rule_application, not pure source mapping).
+      - A model named stg_orders that aggregates orders to a monthly grain.
+    suggested_principles:
+      - Keep source mapping models 1:1 with a source whenever possible.
+      - Avoid joins and row-level business logic here.
+      - Prefer explicit column selection over select *.
+    related_layers: [staging, bronze]
+
+  - id: format_alignment
+    title: Format alignment
+    description: |
+      Standardize data shapes so downstream models can trust types, casing, encoding,
+      and units. The model fixes formats rather than answering business questions.
+    signals:
+      - Name contains clean, cast, typed, normalized, or formatted.
+      - Lives in an intermediate or silver layer and only adjusts formats.
+      - Performs type casts, casing, timezone normalization, or unit conversion.
+    examples:
+      - int_customers_cleaned that casts text ids to integers and lowercases emails.
+      - silver_events_normalized that converts timestamps to UTC.
+    anti_examples:
+      - A model that changes grain or joins entities (that is business rule
+        application).
+      - A staging model that only renames columns (that is source mapping).
+    suggested_principles:
+      - Do one format adjustment per column family and document it.
+      - Never change grain in a format alignment model.
+      - Make casts explicit and lossless where possible.
+    related_layers: [intermediate, silver]
+
+  - id: data_contract_enforcement
+    title: Data contract enforcement
+    description: |
+      Assert and enforce the shape of data that crosses a boundary: not-null columns,
+      uniqueness, accepted values, referential integrity, and freshness. The model (or
+      the tests attached to it) exists to fail loudly when a contract is broken.
+    signals:
+      - Has several attached tests covering not-null, unique, or accepted_values.
+      - Tagged contract, certified, or trusted.
+      - Sits at a layer boundary where downstream consumers depend on guarantees.
+    examples:
+      - A silver model with not-null and unique tests on its primary key.
+      - A staging model tagged contract that gates raw data into the project.
+    anti_examples:
+      - A model with a single sanity test (that is ordinary hygiene, not a contract
+        boundary).
+      - A mart that merely exposes already-tested data.
+    suggested_principles:
+      - Test the contract at the boundary, not only at the mart.
+      - Prefer explicit, named contracts over implicit assumptions.
+      - Make failures actionable and noisy.
+    related_layers: [staging, silver, gold]
+
+  - id: entity_definition
+    title: Entity definition
+    description: |
+      Define a core business entity (customer, order, account) with a stable identity
+      and the attributes that describe it. The model establishes what an entity *is*
+      so other models can reference it.
+    signals:
+      - Name or path references a single entity (customers, orders, accounts).
+      - Tagged entity or lives under models/intermediate/entities/.
+      - Exposes a stable identity key and descriptive attributes.
+    examples:
+      - int_customers_entity resolving a stable customer_id and profile attributes.
+      - dim_accounts defining the account entity used by downstream marts.
+    anti_examples:
+      - A fact table of events (that is analytical output or business rule
+        application).
+      - A staging model that only renames source columns (that is source mapping).
+    suggested_principles:
+      - One entity per model; keep the identity key explicit.
+      - Resolve identity once and reuse, do not re-resolve downstream.
+      - Separate entity definition from metrics and reporting.
+    related_layers: [intermediate, silver]
+
+  - id: business_rule_application
+    title: Business rule application
+    description: |
+      Apply the joins, calculations, and logic that turn raw or aligned data into
+      meaningful records. The model answers "what happened" using business semantics.
+    signals:
+      - Lives in an intermediate or silver layer and joins multiple models.
+      - Name begins with int_ or sits under models/intermediate/.
+      - Applies calculations, lookups, or enrichment beyond format fixes.
+    examples:
+      - int_orders_with_customers joining orders to customers for enrichment.
+      - silver_subscriptions_renewed flagging renewal events.
+    anti_examples:
+      - A staging model that only selects and renames (that is source mapping).
+      - A final mart shaped for a dashboard (that is analytical output shaping).
+    suggested_principles:
+      - Name the rule the model applies, not only the data it touches.
+      - Keep one major business rule per model so logic is traceable.
+      - Document assumptions and edge cases inline.
+    related_layers: [intermediate, silver]
+
+  - id: analytical_output_shaping
+    title: Analytical output shaping
+    description: |
+      Shape data for consumption by people, dashboards, or downstream systems. The
+      model optimizes for a reader: grain, columns, and naming chosen for an audience.
+    signals:
+      - Lives in a marts or gold layer.
+      - Name begins with fct_, dim_, or sits under models/marts/.
+      - Has downstream exposures or consumers.
+      - Materialized as a table for read performance.
+    examples:
+      - fct_orders exposing order events for analytics.
+      - dim_customers shaped for BI tooling and dashboards.
+    anti_examples:
+      - An intermediate model that still applies business logic (that is business
+        rule application).
+      - A model with no downstream consumers that is really an intermediate step.
+    suggested_principles:
+      - Optimize grain and columns for the consumer, not the producer.
+      - Name outputs by the question they answer.
+      - Keep marts thin: push logic into intermediate models.
+    related_layers: [marts, gold]
+
+  - id: quality_validation
+    title: Quality validation
+    description: |
+      Validate data quality through dedicated test models, assertions, or QA models.
+      The model exists to surface data problems rather than to serve analytics.
+    signals:
+      - Name contains quality, assert, qa, or test.
+      - Materialized as a test or ephemeral assertion.
+      - Tagged quality or qa.
+    examples:
+      - orders_quality_checks failing when revenue is negative.
+      - assert_customer_ids_unique surfacing duplicate identities.
+    anti_examples:
+      - A mart that happens to have tests (that is analytical output shaping).
+      - A staging model with ordinary hygiene tests (that is source mapping with a
+        contract).
+    suggested_principles:
+      - Make validation models fail loudly and explain why.
+      - Validate at the boundary where bad data enters.
+      - Prefer reusable checks over one-off assertions.
+    related_layers: [staging, intermediate, marts]
+
+layers:
+  - id: staging
+    description: First trusted relation from a source; often the staging layer.
+    detect:
+      any:
+        - field: path
+          operator: contains
+          value: /staging/
+        - field: tags
+          operator: contains
+          value: staging
+        - field: name
+          operator: regex
+          value: ^stg_
+    implied_jobs: [source_mapping, data_contract_enforcement]
+
+  - id: bronze
+    description: Medallion bronze layer; raw data exposed with minimal change.
+    detect:
+      any:
+        - field: path
+          operator: contains
+          value: /bronze/
+        - field: tags
+          operator: contains
+          value: bronze
+    implied_jobs: [source_mapping]
+
+  - id: intermediate
+    description: Intermediate transformations between staging and marts.
+    detect:
+      any:
+        - field: path
+          operator: contains
+          value: /intermediate/
+        - field: tags
+          operator: contains
+          value: intermediate
+        - field: name
+          operator: regex
+          value: ^int_
+    implied_jobs: [format_alignment, entity_definition, business_rule_application]
+
+  - id: silver
+    description: Medallion silver layer; cleaned and conformed data.
+    detect:
+      any:
+        - field: path
+          operator: contains
+          value: /silver/
+        - field: tags
+          operator: contains
+          value: silver
+    implied_jobs:
+      - format_alignment
+      - data_contract_enforcement
+      - entity_definition
+      - business_rule_application
+
+  - id: marts
+    description: Presentation marts shaped for consumers.
+    detect:
+      any:
+        - field: path
+          operator: contains
+          value: /marts/
+        - field: tags
+          operator: contains
+          value: mart
+        - field: name
+          operator: regex
+          value: ^(fct|dim)_
+    implied_jobs: [analytical_output_shaping, business_rule_application]
+
+  - id: gold
+    description: Medallion gold layer; business-level aggregates and outputs.
+    detect:
+      any:
+        - field: path
+          operator: contains
+          value: /gold/
+        - field: tags
+          operator: contains
+          value: gold
+    implied_jobs: [analytical_output_shaping]
+
+rules:
+  - id: default-source-mapping
+    label: source_mapping
+    priority: 10
+    any:
+      - field: path
+        operator: contains
+        value: /staging/
+      - field: path
+        operator: contains
+        value: /bronze/
+      - field: tags
+        operator: contains
+        value: staging
+      - field: tags
+        operator: contains
+        value: bronze
+      - field: name
+        operator: regex
+        value: ^stg_
+      - field: meta.job
+        operator: equals
+        value: source_mapping
+
+  - id: default-format-alignment
+    label: format_alignment
+    priority: 20
+    any:
+      - field: name
+        operator: regex
+        value: (clean|cast|typed|normaliz|format)
+      - field: tags
+        operator: contains
+        value: format_alignment
+      - field: meta.job
+        operator: equals
+        value: format_alignment
+
+  - id: default-data-contract-enforcement
+    label: data_contract_enforcement
+    priority: 30
+    any:
+      - field: attached_tests
+        operator: count_gte
+        value: 2
+      - field: tags
+        operator: contains_any
+        value: [contract, certified, trusted]
+      - field: meta.job
+        operator: equals
+        value: data_contract_enforcement
+
+  - id: default-entity-definition
+    label: entity_definition
+    priority: 30
+    any:
+      - field: path
+        operator: contains
+        value: /entities/
+      - field: tags
+        operator: contains
+        value: entity
+      - field: meta.job
+        operator: equals
+        value: entity_definition
+
+  - id: default-business-rule-application
+    label: business_rule_application
+    priority: 40
+    any:
+      - field: path
+        operator: contains
+        value: /intermediate/
+      - field: path
+        operator: contains
+        value: /silver/
+      - field: tags
+        operator: contains
+        value: intermediate
+      - field: tags
+        operator: contains
+        value: silver
+      - field: name
+        operator: regex
+        value: ^int_
+      - field: meta.job
+        operator: equals
+        value: business_rule_application
+
+  - id: default-analytical-output-shaping
+    label: analytical_output_shaping
+    priority: 50
+    any:
+      - field: path
+        operator: contains
+        value: /marts/
+      - field: path
+        operator: contains
+        value: /gold/
+      - field: tags
+        operator: contains
+        value: mart
+      - field: tags
+        operator: contains
+        value: gold
+      - field: name
+        operator: regex
+        value: ^(fct|dim)_
+      - field: meta.job
+        operator: equals
+        value: analytical_output_shaping
+
+  - id: default-quality-validation
+    label: quality_validation
+    priority: 60
+    any:
+      - field: name
+        operator: regex
+        value: (quality|assert|qa)
+      - field: tags
+        operator: contains_any
+        value: [quality, qa]
+      - field: materialized
+        operator: equals
+        value: test
+      - field: meta.job
+        operator: equals
+        value: quality_validation
+"""
+
+
+def load_default_taxonomy() -> dict[str, Any]:
+    """Return the parsed default jobs taxonomy as a plain dict.
+
+    The taxonomy is the single source for both documentation and default rules. The
+    return value is freshly parsed each call so callers can safely mutate it.
+    """
+
+    payload = yaml.safe_load(DEFAULT_TAXONOMY_YAML)
+    if not isinstance(payload, dict):
+        raise RuntimeError("Default jobs taxonomy failed to parse as a mapping")
+    return payload
+
+
+def default_classification_rules(
+    *,
+    flag_layer_job_mismatch: bool = True,
+) -> dict[str, Any]:
+    """Return the default jobs taxonomy as a classification rules config.
+
+    The returned config is compatible with ``classify_inventory`` and can be used
+    directly when no project-specific rules file is supplied. Layer/job mismatch
+    detection is enabled by default because the default taxonomy defines the
+    layer-to-job relationships it should check.
+    """
+
+    taxonomy = load_default_taxonomy()
+    rules = list(taxonomy.get("rules") or [])
+    layers = list(taxonomy.get("layers") or [])
+    layer_mapping = [
+        {
+            "id": str(layer.get("id")),
+            "detect": layer.get("detect") or {},
+            "implied_jobs": list(layer.get("implied_jobs") or []),
+            "description": str(layer.get("description") or ""),
+        }
+        for layer in layers
+        if isinstance(layer, dict) and layer.get("id")
+    ]
+    return {
+        "schema_version": "fyrnheim.dbt_classification_rules.v1",
+        "rules_source": DEFAULT_CLASSIFICATION_RULES_SOURCE,
+        "allow_multiple_labels": True,
+        "flag_layer_job_mismatch": flag_layer_job_mismatch,
+        "rules": rules,
+        "layer_mapping": layer_mapping,
+    }
+
+
+def load_default_classification_rules() -> dict[str, Any]:
+    """Load default classification rules (alias for clarity at call sites)."""
+
+    return default_classification_rules()
+
+
+def describe_default_job(job_id: str) -> dict[str, Any] | None:
+    """Return the taxonomy entry for a single default job, or None."""
+
+    taxonomy = load_default_taxonomy()
+    for job in taxonomy.get("jobs") or []:
+        if isinstance(job, dict) and job.get("id") == job_id:
+            return job
+    return None
