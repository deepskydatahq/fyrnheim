+"""Default jobs taxonomy for dbt model classification."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+from fyrnheim.dbt_classification import load_classification_rules
+
+# Path to the default taxonomy file
+DEFAULT_TAXONOMY_PATH = Path(__file__).parent / "default_jobs_taxonomy.yml"
+
+
+def load_default_taxonomy() -> dict[str, Any]:
+    """Load the default jobs taxonomy rules."""
+    return load_classification_rules(DEFAULT_TAXONOMY_PATH)
+
+
+def default_taxonomy_json() -> str:
+    """Return the default taxonomy as JSON string."""
+    taxonomy = load_default_taxonomy()
+    return json.dumps(taxonomy, indent=2, sort_keys=True) + "\n"
+
+
+def default_taxonomy_summary() -> str:
+    """Return a summary of the default taxonomy."""
+    taxonomy = load_default_taxonomy()
+    rules = taxonomy.get("rules", [])
+
+    lines = ["Default Jobs Taxonomy for dbt Models", "=" * 40]
+
+    for rule in rules:
+        label = rule.get("label", "unnamed")
+        description = rule.get("description", "No description")
+        lines.append(f"{label.upper()}: {description}")
+
+    lines.append(f"\nTotal jobs: {len(rules)}")
+
+    return "\n".join(lines) + "\n"
+
+
+def validate_default_taxonomy() -> list[str]:
+    """Validate the default taxonomy and return any issues found."""
+    issues = []
+    try:
+        taxonomy = load_default_taxonomy()
+        rules = taxonomy.get("rules", [])
+
+        if not rules:
+            issues.append("No rules found in taxonomy")
+            return issues
+
+        rule_ids = set()
+        for i, rule in enumerate(rules):
+            rule_id = rule.get("id")
+            if not rule_id:
+                issues.append(f"Rule {i} missing required 'id' field")
+            elif rule_id in rule_ids:
+                issues.append(f"Duplicate rule id: {rule_id}")
+            else:
+                rule_ids.add(rule_id)
+
+            if not rule.get("label"):
+                issues.append(f"Rule {rule_id or i} missing required 'label' field")
+
+            if not rule.get("description"):
+                issues.append(f"Rule {rule_id or i} missing 'description' field")
+
+    except Exception as e:
+        issues.append(f"Failed to load taxonomy: {e}")
+
+    return issues
