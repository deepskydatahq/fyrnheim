+"""Tests for the default jobs taxonomy functionality."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import yaml
+from click.testing import CliRunner
+
+from fyrnheim.cli import main
+from fyrnheim.dbt_default_taxonomy import (
+    default_taxonomy_json,
+    default_taxonomy_summary,
+    load_default_taxonomy,
+    validate_default_taxonomy,
+)
+
+
+def test_load_default_taxonomy() -> None:
+    """Test that the default taxonomy can be loaded successfully."""
+    taxonomy = load_default_taxonomy()
+
+    # Check that it has the expected structure
+    assert "schema_version" in taxonomy
+    assert "rules" in taxonomy
+    assert isinstance(taxonomy["rules"], list)
+    assert len(taxonomy["rules"]) > 0
+
+    # Check that each rule has required fields
+    rules = taxonomy["rules"]
+    assert len(rules) > 0, "No rules found in taxonomy"
+
+    for rule in rules:
+        assert "id" in rule, f"Rule missing id: {rule}"
+        assert "label" in rule, f"Rule missing label: {rule}"
+        assert "description" in rule, f"Rule missing description: {rule}"
+
+
+def test_validate_default_taxonomy() -> None:
+    """Test that the default taxonomy validation works."""
+    issues = validate_default_taxonomy()
+    assert len(issues) == 0, f"Validation issues found: {issues}"
+
+
+def test_default_taxonomy_summary() -> None:
+    """Test that the default taxonomy summary can be generated."""
+    summary = default_taxonomy_summary()
+
+    assert isinstance(summary, str)
+    assert "Default Jobs Taxonomy" in summary
+
+
+def test_default_taxonomy_json() -> None:
+    """Test that the default taxonomy can be serialized to JSON."""
+    json_str = default_taxonomy_json()
+
+    assert isinstance(json_str, str)
+    # Should be valid JSON
+    parsed = json.loads(json_str)
+    assert "schema_version" in parsed
+
+
+def test_dbt_classify_cli_with_default_taxonomy(tmp_path: Path) -> None:
+    """Test the CLI classify command with the default taxonomy."""
+    # Create a sample inventory
+    inventory_path = tmp_path / "inventory.json"
+    inventory_path.write_text(
+        json.dumps({
+            "schema_version": "fyrnheim.dbt_inventory.v1",
+            "project": {"name": "test_project"},
+            "resources": {
+                "models": [{
+                    "unique_id": "model.test_project.stg_customers",
+                    "name": "stg_customers",
+                    "path": "models/staging/stg_customers.sql",
+                    "materialized": "view",
+                    "tags": ["staging"]
+                }]
+            }
+        }),
+        encoding="utf-8"
+    )
+
+    # Run classification with default taxonomy
+    result = CliRunner().invoke(
+        main,
+        [
+            "dbt",
+            "classify",
+            "--inventory",
+            str(inventory_path),
+            "--use-default",
+        ],
+    )
+
+    assert result.exit_code == 0, result.output
+    assert "dbt project: test_project" in result.output
+
+
+def test_dbt_classify_cli_mutual_exclusive_options(tmp_path: Path) -> None:
+    """Test that --rules and --use-default are mutually exclusive."""
+    # Create a sample inventory
+    inventory_path = tmp_path / "inventory.json"
+    inventory_path.write_text(
+        json.dumps({"schema_version": "test", "project": {}, "resources": {}}),
+        encoding="utf-8"
+    )
+
+    # Create a dummy rules file
+    rules_path = tmp_path / "rules.yml"
+    rules_path.write_text(yaml.safe_dump({"schema_version": "test", "rules": []}), encoding="utf-8")
+
+    # Try to use both options
+    result = CliRunner().invoke(
+        main,
+        [
+            "dbt",
+            "classify",
+            "--inventory",
+            str(inventory_path),
+            "--rules",
+            str(rules_path),
+            "--use-default",
+        ],
+    )
+
+    assert result.exit_code != 0
+    assert "Cannot specify both --rules and --use-default" in result.output
+
+
+def test_dbt_classify_cli_requires_rules_or_default(tmp_path: Path) -> None:
+    """Test that either --rules or --use-default must be specified."""
+    # Create a sample inventory
+    inventory_path = tmp_path / "inventory.json"
+    inventory_path.write_text(
+        json.dumps({"schema_version": "test", "project": {}, "resources": {}}),
+        encoding="utf-8"
+    )
+
+    # Try to run without either option
+    result = CliRunner().invoke(
+        main,
+        [
+            "dbt",
+            "classify",
+            "--inventory",
+            str(inventory_path),
+        ],
+    )
+
+    assert result.exit_code != 0
+    assert "Either --rules or --use-default must be specified" in result.output
